# =============================================================================
# HANTUTOR ENVIRONMENT VARIABLES (.env.example)
# Sao chép file này thành .env.local và điền thông tin dự án Supabase của bạn.
# =============================================================================

# Supabase Production Project URL & Public Anon Key
# Lấy tại: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini API Key phục vụ trợ lý AI HanTutor
VITE_GEMINI_API_KEY=your-gemini-api-key-here
